	(text "Power Sequence 1V0 18ms -> 1V8 18ms -> 1V35 18ms -> 3V3\n\nCompensation network assumes maximum current draw on each channel\ndue to the unpredictable FPGA current draw\n\nVout = Vref(R2/(R1+R2)), where Vref=2V0\nL = (Vin - Vout)(Vout/Vin)/(0.3I * fsw)\n\nFor 3V3, tie Vset to 2V0 and use PD on FB"
		(exclude_from_sim no)
		(at 21.844 35.052 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4295a21a-c83c-441e-a152-3a6670000156")
	)
