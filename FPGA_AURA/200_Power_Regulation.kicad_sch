			)
			(justify left top)
		)
		(uuid "ca71b492-8aa2-49ce-8d23-120e9976b618")
	)
	(text "RT: 1MHz\nCFG1: 4A, 4A, 2A, 2A\nCFG2: Sequnce, 1x, FPWM, UVO\nEN3/UV: 3V9 cut-off\nEN2/DL12: 2ms (soft start), 6ms\nEN4/DL34: 12ms, 12ms"
		(exclude_from_sim no)
		(at 168.91 181.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
